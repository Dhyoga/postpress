# ==========================================
# Database & Supabase (Postgres via Drizzle)
# ==========================================
# Gunakan connection string dari Supabase (Database Settings -> Connection string -> Session / Direct)
DATABASE_URL=postgres://postgres.[ref]:[password]@aws-0-[region].pooler.supabase.com:6543/postgres

# (Opsional) Jika kamu juga menggunakan Supabase SDK di client/server:
NEXT_PUBLIC_SUPABASE_URL=https://[ref].supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_...
SUPABASE_SECRET_KEY=sb_secret_... # Rahasia, server-side only

# ==========================================
# Auth & Security
# ==========================================
# 32 byte random hex, mis. `openssl rand -hex 32`
SESSION_SECRET=your-32-byte-random-session-secret
TOKEN_ENCRYPTION_KEY=your-32-byte-random-encryption-key

# Cron Protection — dikirim sebagai header `Authorization: Bearer <CRON_SECRET>`
# ke endpoint app/api/cron/*
CRON_SECRET=your-cron-secret-token

# ==========================================
# LLM Config — fallback opsional
# ==========================================
# Provider/base URL/API key/model normalnya diatur lewat Pengaturan > Konfigurasi
# LLM di UI (tersimpan terenkripsi di tabel `llm_settings`). Variabel di bawah
# ini cuma dipakai kalau baris DB belum diisi (format Anthropic Messages API).
ANTHROPIC_AUTH_TOKEN=sk-ant-...
ANTHROPIC_BASE_URL=https://api.anthropic.com
ANTHROPIC_MODEL=claude-opus-5

# ==========================================
# Object Storage (Cloudflare R2)
# ==========================================
R2_ACCOUNT_ID=your-r2-account-id
R2_ACCESS_KEY_ID=your-r2-access-key-id
R2_SECRET_ACCESS_KEY=your-r2-secret-access-key
R2_BUCKET=postpress-media
NEXT_PUBLIC_R2_BASE_URL=https://pub-xxx.r2.dev

# ==========================================
# Meta / Instagram Graph API
# ==========================================
META_APP_ID=your-meta-app-id
META_APP_SECRET=your-meta-app-secret
META_API_VERSION=v26.0

# ==========================================
# Notifikasi kegagalan job (opsional, pilih salah satu / keduanya)
# ==========================================
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
NOTIFY_EMAIL_TO=
NOTIFY_EMAIL_FROM=
RESEND_API_KEY=

# ==========================================
# Pemantauan uptime cron (opsional)
# ==========================================
# URL dasar layanan ping-based monitoring (healthchecks.io, Cronitor,
# BetterUptime, dst). Tiap job cron mem-ping "<base>/<nama-job>" setelah
# selesai — kalau ping tidak sampai dalam jendela yang diharapkan, layanan
# itu yang mengirim alert. Kosongkan untuk mematikan pemantauan.
CRON_HEARTBEAT_BASE_URL=
